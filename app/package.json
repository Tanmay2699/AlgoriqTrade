{
  "name": "@alphaedge/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen:disclaimers": "node scripts/gen-disclaimers.mjs",
    "check:disclaimers": "node scripts/gen-disclaimers.mjs --check",
    "check:claims": "node scripts/check-claims.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:charges": "node scripts/check-charges.mjs",
    "check:stats": "node scripts/check-stats.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lighthouse": "^12.6.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
